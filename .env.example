# Content Factory - Environment Variables Template
# =================================================
# Copy this file to .env and fill in your API keys

# ===================
# LLM PROVIDER (Required)
# ===================
GROQ_API_KEY=your_groq_api_key_here

# Ollama fallback (optional - only if not using Groq)
OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ===================
# TEXT-TO-SPEECH (Optional - choose one)
# ===================
# Option 1: Google Cloud TTS
TTS_PROVIDER=google
GOOGLE_CLOUD_TTS_API_KEY=your_google_cloud_tts_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here

# Option 2: Kokoro TTS (free, runs locally - no key needed)
# Just set: TTS_PROVIDER=kokoro

# ===================
# SOCIAL MEDIA PUBLISHING (Optional)
# ===================

# Twitter/X API v2
# Get your keys from: https://developer.twitter.com/
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# LinkedIn
# Get your access token from: https://www.linkedin.com/developers/apps
LINKEDIN_TOKEN=your_linkedin_access_token_here
LINKEDIN_ORGANIZATION_ID=your_linkedin_org_id_here

# Dev.to
# Get your API key from: https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# Medium
# Get your integration token from: https://medium.com/me/settings
MEDIUM_INTEGRATION_TOKEN=your_medium_token_here

# Hashnode
# Get your API token from: https://hashnode.com/settings/developer
HASHNODE_API_TOKEN=your_hashnode_token_here

# Ghost CMS (for blogging platforms using Ghost)
GHOST_API_URL=https://your-ghost-site.com
GHOST_API_KEY=your_ghost_admin_api_key_here

# WordPress (self-hosted or .com)
WORDPRESS_URL=https://your-site.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_app_password

# ===================
# DISCORD WEBHOOK (Optional)
# ===================
# Get webhook from: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx

# ===================
# WEBHOOK SECURITY (Optional)
# ===================
# Secret for securing webhook endpoints
# If set, use X-Webhook-Secret header when calling /api/webhook/secure
WEBHOOK_SECRET=your_secure_random_string

# ===================
# IMAGE GENERATION (No key needed)
# ===================
# Uses Pollinations.ai (free) - no configuration needed
# IMAGE_PROVIDER=pollinations

# ===================
# SEARCH TOOLS (No key needed)
# ===================
# Uses DuckDuckGo (free) - no configuration needed